{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxc-project/refs/heads/nicolo/config-json-schema/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "jsPlugins": ["./scripts/oxlint-plugin-reins.cjs"],
  "rules": {
    "no-new": "off",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/require-post-message-target-origin": "off",
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "reins/no-reexports": "error",
    "reins/no-exported-type-realiases": "error"
  },
  "overrides": [
    {
      "files": ["packages/frontend/src/components/**/*.ts"],
      "rules": {
        "reins/no-custom-event-constructor": "error",
        "reins/no-inline-svg": "error"
      }
    },
    {
      "files": [
        "packages/frontend/src/components/events.ts",
        "packages/frontend/src/components/assistant-session.ts",
        "packages/frontend/src/components/changes/codeview-diff-panel.ts",
        "packages/frontend/src/components/changes/diff-file-tree.ts",
        "packages/frontend/src/components/changes/diff-hunk.ts",
        "packages/frontend/src/components/changes/diff-panel.ts",
        "packages/frontend/src/components/chat-composer.ts",
        "packages/frontend/src/components/delegate-popover.ts",
        "packages/frontend/src/components/delete-task-dialog.ts",
        "packages/frontend/src/components/file-viewer/file-viewer-html.ts",
        "packages/frontend/src/components/project-form.ts",
        "packages/frontend/src/components/search-palette.ts",
        "packages/frontend/src/components/session-list-item.ts",
        "packages/frontend/src/components/settings/model-selector-controls.ts",
        "packages/frontend/src/components/sidebar-project.ts",
        "packages/frontend/src/components/skill-suggest.ts",
        "packages/frontend/src/components/task-detail.ts",
        "packages/frontend/src/components/task-list-item.ts",
        "packages/frontend/src/components/task-list.ts",
        "packages/frontend/src/components/tree-view.ts",
        "packages/frontend/src/components/view-mode-tabs.ts"
      ],
      "rules": {
        "reins/no-custom-event-constructor": "off"
      }
    },
    {
      "files": ["packages/frontend/src/components/icons.ts"],
      "rules": {
        "reins/no-inline-svg": "off"
      }
    },
    {
      "files": ["packages/backend/src/**/*.ts"],
      "rules": {
        "no-console": "error"
      }
    },
    {
      "files": [
        "packages/backend/src/logger.ts",
        "packages/backend/src/__tests__/**/*.ts"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
