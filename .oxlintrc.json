{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxc-project/refs/heads/nicolo/config-json-schema/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "jsPlugins": ["./scripts/oxlint-plugin-reins.cjs"],
  "rules": {
    "no-new": "off",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/require-post-message-target-origin": "off",
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "reins/no-telemetry-error-guards": "error",
    "reins/no-reexports": "error",
    "reins/no-exported-type-realiases": "error"
  },
  "overrides": [
    {
      "files": ["packages/frontend/src/**/*.ts"],
      "rules": {
        "reins/frontend-backend-imports-type-only": "error"
      }
    },
    {
      "files": ["packages/frontend/src/components/**/*.ts"],
      "rules": {
        "reins/no-custom-event-constructor": "error",
        "reins/no-inline-svg": "error"
      }
    },
    {
      "files": ["packages/frontend/src/ui/**/*.ts"],
      "rules": {
        "reins/no-inline-svg": "error"
      }
    },
    {
      "files": ["packages/frontend/src/components/events.ts"],
      "rules": {
        "reins/no-custom-event-constructor": "off"
      }
    },
    {
      "files": ["packages/frontend/src/ui/icons.ts"],
      "rules": {
        "reins/no-inline-svg": "off"
      }
    },
    {
      "files": ["packages/backend/src/**/*.ts"],
      "rules": {
        "no-console": "error",
        "reins/node-import-boundary": "error"
      }
    },
    {
      "files": ["packages/node/src/**/*.ts"],
      "rules": { "reins/node-implementation-isolation": "error" }
    },
    {
      "files": ["packages/node/src/contract.ts"],
      "rules": { "reins/node-contract-isolation": "error" }
    },
    {
      "files": [
        "packages/backend/src/logger.ts",
        "packages/backend/src/__tests__/**/*.ts"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
