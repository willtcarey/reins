{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": "src",
    "types": ["@types/bun"],
    "paths": {
      "@reins/sdk/server": ["./src/sdk/server/index.ts"]
    }
  },
  "include": ["src"]
}
