{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "..",
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@backend/*": ["../backend/src/*"],
      "reins-sdk/contract": ["./src/reins-sdk/contract.ts"]
    }
  },
  "include": ["src"]
}
